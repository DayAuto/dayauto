# 이 파일을 복사해 .env.local 생성. 실제 값은 팀 보관소에서.
# NEXT_PUBLIC_ 접두어 변수는 브라우저에 노출되므로 비밀값에 사용 금지.

# --- DB ---
# Supabase Session pooler(5432) 연결 문자열. ?pgbouncer=true는 붙이지 않는다.
# 런타임(@prisma/adapter-pg)과 마이그레이션(prisma.config.ts)이 같은 값을 쓴다.
DATABASE_URL=

# --- 인증 ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- 배치 ---
CRON_SECRET=

# --- 알림 ---
RESEND_API_KEY=

# --- 분석·모니터링 ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# --- LLM ---
# LLM_API_KEY — 공급자 확정 후 이름 결정 (TBD)
